{
  "schemaVersion": 1,
  "pathsAreRelativeTo": "repository root",
  "probeMatching": "Expected objects are recursive subsets; expected arrays match positions and length. Every response must also have the expected revision. Fields omitted from expected are not ignored by the fixture smoke checks.",
  "runtimes": {
    "node": "22.22.0",
    "python": "3.11.14",
    "lambdaRuntime": "nodejs22.x"
  },
  "lambda": {
    "context": "fixtures/lambdas",
    "dependencyLock": "fixtures/lambdas/package-lock.json",
    "workloads": [
      {
        "id": "lambda-5",
        "description": "A small storefront backend",
        "functions": [
          "report",
          "product-lookup",
          "cart-pricing",
          "create-order",
          "notification"
        ],
        "changedFunctions": [
          "report",
          "product-lookup",
          "cart-pricing",
          "create-order",
          "notification"
        ]
      }
    ],
    "functions": [
      {
        "name": "report",
        "entry": "fixtures/lambdas/handlers/report.mjs",
        "handler": "handler",
        "revisionFile": "fixtures/lambdas/handlers/report.revision.mjs",
        "probe": {
          "input": {},
          "expected": {
            "total": "33.00",
            "files": [
              {
                "type": "pdf",
                "prefix": "%PDF"
              },
              {
                "type": "xlsx",
                "prefix": "PK"
              },
              {
                "type": "docx",
                "prefix": "PK"
              }
            ]
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "product-lookup",
        "entry": "fixtures/lambdas/handlers/product-lookup.mjs",
        "handler": "handler",
        "revisionFile": "fixtures/lambdas/handlers/product-lookup.revision.mjs",
        "probe": {
          "input": {},
          "expected": {
            "product": {
              "id": "coffee",
              "price": "12.50"
            }
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "cart-pricing",
        "entry": "fixtures/lambdas/handlers/cart-pricing.mjs",
        "handler": "handler",
        "revisionFile": "fixtures/lambdas/handlers/cart-pricing.revision.mjs",
        "probe": {
          "input": {},
          "expected": {
            "subtotal": "33.00",
            "currency": "USD"
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "create-order",
        "entry": "fixtures/lambdas/handlers/create-order.mjs",
        "handler": "handler",
        "revisionFile": "fixtures/lambdas/handlers/create-order.revision.mjs",
        "probe": {
          "input": {},
          "expected": {
            "status": "accepted",
            "total": "33.00"
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "notification",
        "entry": "fixtures/lambdas/handlers/notification.mjs",
        "handler": "handler",
        "revisionFile": "fixtures/lambdas/handlers/notification.revision.mjs",
        "probe": {
          "input": {},
          "expected": {
            "recipient": "alex@example.test",
            "html": "<p>Your order order-100 has been accepted.</p>"
          },
          "revisionField": "revision"
        }
      }
    ]
  }
}

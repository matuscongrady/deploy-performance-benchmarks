{
  "schemaVersion": 1,
  "pathsAreRelativeTo": "repository root",
  "probeMatching": "Expected objects are recursive subsets; expected arrays match positions and length. Every response must also have the expected revision. Fields omitted from expected are not ignored by the fixture smoke checks.",
  "runtimes": {
    "node": "22.22.0",
    "python": "3.11.14",
    "lambdaRuntime": "nodejs22.x"
  },
  "containers": [
    {
      "id": "container-python",
      "description": "One Python commerce API",
      "buildContext": "fixtures/containers/python",
      "startCommand": "uvicorn app:app --host 0.0.0.0 --port ${PORT:-3000}",
      "port": 3000,
      "revisionFile": "fixtures/containers/python/revision.py",
      "versionProbe": {
        "method": "GET",
        "path": "/version",
        "expected": {
          "service": "commerce-api"
        },
        "revisionField": "revision"
      },
      "businessProbe": {
        "method": "POST",
        "path": "/quote",
        "body": {
          "lines": [
            {
              "productId": "coffee",
              "quantity": 2
            },
            {
              "productId": "mug",
              "quantity": 1
            }
          ]
        },
        "expected": {
          "total": "33.00",
          "currency": "USD"
        },
        "revisionField": "revision"
      },
      "dependencyLock": "fixtures/containers/python/requirements.txt"
    }
  ]
}

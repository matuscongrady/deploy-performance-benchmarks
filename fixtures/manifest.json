{
  "schemaVersion": 1,
  "pathsAreRelativeTo": "repository root",
  "probeMatching": "Expected objects are recursive subsets; expected arrays match positions and length. Every response must also have the expected revision. Fields omitted from expected are not ignored by the fixture smoke checks.",
  "runtimes": {
    "node": "22.22.0",
    "python": "3.11.14",
    "lambdaRuntime": "nodejs22.x"
  },
  "fiveServices": {
    "id": "containers-five",
    "description": "Five independent commerce services; update three and retain two",
    "services": [
      {
        "name": "api",
        "buildContext": "fixtures/containers/five-services/api",
        "startCommand": "npm start",
        "port": 3000,
        "dependencyLock": "fixtures/containers/five-services/api/package-lock.json",
        "revisionFile": "fixtures/containers/five-services/api/revision.mjs",
        "versionProbe": {
          "method": "GET",
          "path": "/version",
          "expected": {
            "service": "api"
          },
          "revisionField": "revision"
        },
        "businessProbe": {
          "path": "/quote",
          "method": "POST",
          "body": {
            "quantity": 2
          },
          "expected": {
            "total": "25.00"
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "reporting",
        "buildContext": "fixtures/containers/five-services/reporting",
        "startCommand": "npm start",
        "port": 3000,
        "dependencyLock": "fixtures/containers/five-services/reporting/package-lock.json",
        "revisionFile": "fixtures/containers/five-services/reporting/revision.mjs",
        "versionProbe": {
          "method": "GET",
          "path": "/version",
          "expected": {
            "service": "reporting"
          },
          "revisionField": "revision"
        },
        "businessProbe": {
          "path": "/report",
          "method": "POST",
          "body": {
            "jobId": "fresh-probe-job",
            "sales": 33
          },
          "expected": {
            "jobId": "fresh-probe-job",
            "format": "%PDF"
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "inventory",
        "buildContext": "fixtures/containers/five-services/inventory",
        "startCommand": "npm start",
        "port": 3000,
        "dependencyLock": "fixtures/containers/five-services/inventory/package-lock.json",
        "revisionFile": "fixtures/containers/five-services/inventory/revision.mjs",
        "versionProbe": {
          "method": "GET",
          "path": "/version",
          "expected": {
            "service": "inventory"
          },
          "revisionField": "revision"
        },
        "businessProbe": {
          "path": "/reserve",
          "method": "POST",
          "body": {
            "productId": "mug",
            "quantity": 2
          },
          "expected": {
            "remaining": 10
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "webhooks",
        "buildContext": "fixtures/containers/five-services/webhooks",
        "startCommand": "npm start",
        "port": 3000,
        "dependencyLock": "fixtures/containers/five-services/webhooks/package-lock.json",
        "revisionFile": "fixtures/containers/five-services/webhooks/revision.mjs",
        "versionProbe": {
          "method": "GET",
          "path": "/version",
          "expected": {
            "service": "webhooks"
          },
          "revisionField": "revision"
        },
        "businessProbe": {
          "path": "/webhook",
          "method": "POST",
          "body": {
            "payload": "{\"orderId\":\"order-100\",\"status\":\"paid\"}"
          },
          "sign": "signature",
          "expected": {
            "accepted": true
          },
          "revisionField": "revision"
        }
      },
      {
        "name": "notifications",
        "buildContext": "fixtures/containers/five-services/notifications",
        "startCommand": "npm start",
        "port": 3000,
        "dependencyLock": "fixtures/containers/five-services/notifications/package-lock.json",
        "revisionFile": "fixtures/containers/five-services/notifications/revision.mjs",
        "versionProbe": {
          "method": "GET",
          "path": "/version",
          "expected": {
            "service": "notifications"
          },
          "revisionField": "revision"
        },
        "businessProbe": {
          "path": "/notify",
          "method": "POST",
          "body": {
            "jobId": "fresh-probe-job",
            "email": "alex@example.test",
            "orderId": "order-100"
          },
          "expected": {
            "jobId": "fresh-probe-job",
            "status": "processed",
            "html": "<p>Order order-100 is ready.</p>"
          },
          "revisionField": "revision"
        }
      }
    ],
    "changedServices": [
      "api",
      "reporting",
      "notifications"
    ],
    "unchangedServices": [
      "inventory",
      "webhooks"
    ],
    "buildContextRule": "Each service directory is its entire build context; never use the repository root as its context.",
    "backgroundWorkerNote": "Reporting and notification requests perform fresh jobs synchronously and include a supplied jobId in the result. This fixture does not claim to benchmark external queues or long-running background workers."
  }
}
